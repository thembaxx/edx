{
  "name": "edx-school",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "generate:icons": "node scripts/generate-icons.mjs",
    "dev": "pnpm run generate:icons && next dev",
    "build": "pnpm run generate:icons && next build",
    "start": "next start",
    "lint": "oxlint app src",
    "lint:fix": "oxlint --fix app src",
    "format": "oxfmt app src scripts next.config.ts",
    "format:check": "oxfmt --check app src scripts next.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "motion": "^14.5.0",
    "next": "16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
